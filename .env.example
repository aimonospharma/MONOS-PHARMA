# MP team — орчны хувьсагчид
# Dokploy → Environment tab дээр эдгээрийг нэмнэ. Энэ файлыг хуулбарлаад
# бодит утгаа бөглөнө. Бодит утгатай .env файлыг git-д ХЭЗЭЭ Ч бүү оруул.

# ─── Аюулгүй байдал (production-д ЗААВАЛ) ────────────────────────────────
# Санамсаргүй 64 тэмдэгт. Үүсгэх:  openssl rand -hex 32
SECRET_KEY=

# Cookie-г зөвхөн HTTPS-ээр явуулна
SESSION_HTTPS_ONLY=1

# 0 = production (mock login, demo account хаагдана) · 1 = зөвхөн локал туршилт
DEMO_MODE=0

# SSO залгагдах хүртэлх түр хамгаалалт — нэвтрэхэд шаардах нууц үг
LOGIN_PASSWORD=

# Admin эрх авах хаягууд (таслалаар тусгаарлана). Бусад нь автоматаар Viewer.
ADMIN_EMAILS=ner.o@monos.mn

# ─── Домэйн ──────────────────────────────────────────────────────────────
# Teams карт дээрх "Үзэх" товчны бүтэн хаяг үүсгэхэд хэрэглэнэ. Заавал.
PUBLIC_BASE_URL=https://mpteam.lab.coremind.mn

# ─── Өгөгдөл хадгалалт (volume холбосны дараа) ───────────────────────────
# Эдгээрийг заахгүй бол өгөгдөл контейнер дотор үлдэж, дахин deploy хийхэд УСТАНА.
MP_DATA_DIR=/data/db
MP_STORAGE_DIR=/data/storage

# ─── Бусад ───────────────────────────────────────────────────────────────
# Урд талын proxy (Traefik/nginx)-ийн client_max_body_size-тай ижил байлгана
MAX_UPLOAD_MB=512
PORT=8000

# ─── Microsoft Entra ID SSO (дараагийн үе шат) ───────────────────────────
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
