# MP team — орчны хувьсагчид
# Dokploy → Environment tab дээр эдгээрийг нэмнэ. Энэ файлыг хуулбарлаад
# бодит утгаа бөглөнө. Бодит утгатай .env файлыг git-д ХЭЗЭЭ Ч бүү оруул.

# ─── Аюулгүй байдал (production-д ЗААВАЛ) ────────────────────────────────
# Санамсаргүй 64 тэмдэгт. Үүсгэх:  openssl rand -hex 32
SECRET_KEY=

# Cookie-г зөвхөн HTTPS-ээр явуулна
SESSION_HTTPS_ONLY=1

# 0 = production (mock login, demo account хаагдана) · 1 = зөвхөн локал туршилт
DEMO_MODE=0

# LOGIN_PASSWORD ашиглахаа больсон. Нууц үг нь хэрэглэгчийн мэйлийн ID хэсэг
# (ner.o@monos.mn -> ner.o), нэвтрэхийг зөвшөөрөх шалгуур нь админаас
# оруулсан ажилтны бүртгэл (/admin/directory).

# Admin эрх авах хаягууд (таслалаар тусгаарлана). Бусад нь автоматаар Viewer.
ADMIN_EMAILS=ner.o@monos.mn

# ─── Домэйн ──────────────────────────────────────────────────────────────
# Teams карт дээрх "Үзэх" товчны бүтэн хаяг үүсгэхэд хэрэглэнэ. Заавал.
PUBLIC_BASE_URL=https://mpteam.lab.coremind.mn

# ─── Өгөгдөл хадгалалт (volume холбосны дараа) ───────────────────────────
# Эдгээрийг заахгүй бол өгөгдөл контейнер дотор үлдэж, дахин deploy хийхэд УСТАНА.
MP_DATA_DIR=/data/db
MP_STORAGE_DIR=/data/storage

# ─── Бусад ───────────────────────────────────────────────────────────────
# Урд талын proxy (Traefik/nginx)-ийн client_max_body_size-тай ижил байлгана
MAX_UPLOAD_MB=512
PORT=8000

# ─── Microsoft Entra ID SSO ──────────────────────────────────────────────
# Гурвуулаа бөглөгдмөгц SSO автоматаар идэвхжиж, LOGIN_PASSWORD шаардахаа болино.
# Azure Portal → Microsoft Entra ID → App registrations дээрээс авна:
#   AZURE_TENANT_ID     ← Overview → Directory (tenant) ID
#   AZURE_CLIENT_ID     ← Overview → Application (client) ID
#   AZURE_CLIENT_SECRET ← Certificates & secrets → New client secret
#
# App registration дээр бүртгүүлэх Redirect URI (Web):
#   <PUBLIC_BASE_URL>/auth/microsoft/callback
# API permissions (delegated): openid, profile, email, User.Read
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Нэвтрэхийг зөвшөөрөх домэйн (таслалаар). Хоосон бол monos.mn
ALLOWED_EMAIL_DOMAINS=monos.mn
